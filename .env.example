# ================================================================
# AI Robustness Defence Lab - Production Environment Variables
# ================================================================

# General Application
PROJECT_NAME="Adversarial Robustness Evaluation & Defence Framework for AI-Based Malware and Intrusion Classifiers"
SHORT_NAME="AI Robustness Defence Lab"
ENVIRONMENT=production
PORT=8000

# Database Configuration
# SQLite (Local / Demo): sqlite:///./app.db
# PostgreSQL (Render / Supabase / Neon): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./app.db

# JWT Security (Generate a secure 256-bit random key for production)
JWT_SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL (Used for CORS authorization)
# Example: https://ai-robustness-defence-lab.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
CORS_ORIGINS=["https://your-frontend-domain.vercel.app", "http://localhost:5173", "http://localhost:3000"]

# Storage & File Limits
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
SAMPLE_DIR=./data/sample
MODEL_DIR=./models/saved_models
REPORT_DIR=./reports
LOG_DIR=./logs
MAX_UPLOAD_MB=50

# Frontend Build Variable (Set in Vercel project environment variables)
# Points to your deployed Render backend URL
VITE_API_BASE_URL=https://your-backend-domain.onrender.com
